{
  "name": "mdestafadilah/satusehat-sdk",
  "description": "Unofficial API wrapper package to integrate with SATUSEHAT platform (fork of agumil/satusehat-sdk with PR #13 updates).",
  "type": "library",
  "keywords": [
    "satusehat",
    "kemkes",
    "fhir",
    "fhir-r4",
    "kfa",
    "kyc",
    "healthcare",
    "indonesia"
  ],
  "homepage": "https://github.com/mdestafadilah/satusehat-sdk-forking",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/mdestafadilah/satusehat-sdk-forking/issues",
    "source": "https://github.com/mdestafadilah/satusehat-sdk-forking"
  },
  "autoload": {
    "psr-4": {
      "agumil\\SatuSehatSDK\\": "src/"
    },
    "files": [
      "src/_ssfunctions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "agumil\\SatuSehatSDK\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:compat": "phpunit --no-configuration --bootstrap vendor/autoload.php --no-coverage tests"
  },
  "authors": [
    {
      "name": "Agung Gumilang",
      "email": "agung96gumilang@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.0",
    "guzzlehttp/guzzle": "^7.16",
    "guzzlehttp/psr7": "^2.13",
    "guzzlehttp/promises": "^2.6",
    "vlucas/phpdotenv": "^5.6",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
  }
}
